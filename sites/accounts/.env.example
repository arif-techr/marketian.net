# Copy this file to `.env` and fill in the values.

# --- Core ---------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=accounts.marketian.net
CSRF_TRUSTED_ORIGINS=https://accounts.marketian.net
TIME_ZONE=Asia/Dhaka

# --- Database (shared PostgreSQL) -----------------------------------------
# Get these three lines from:  bash scripts/create-db.sh accounts
POSTGRES_DB=accounts
POSTGRES_USER=accounts
POSTGRES_PASSWORD=change-me

# --- Sign in with GitHub --------------------------------------------------
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL:               https://accounts.marketian.net
#   Authorization callback URL: https://accounts.marketian.net/accounts/github/login/callback/
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email (verification and password-reset emails) -----------------------
# optional: sign-up works without clicking the email link. Switch to mandatory once email sends.
EMAIL_VERIFICATION=optional
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=no-reply@marketian.net
EMAIL_HOST_PASSWORD=your-mailbox-password
DEFAULT_FROM_EMAIL=Marketian <no-reply@marketian.net>
