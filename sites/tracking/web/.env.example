# Copy this file to `.env` and fill in the values.

# --- Product ------------------------------------------------------------
PRODUCT_NAME=Tracking
PRODUCT_TAGLINE=Server-side tracking for Meta, Google Analytics and more, on your own domain.

# --- Core ---------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=tracking.marketian.net
CSRF_TRUSTED_ORIGINS=https://tracking.marketian.net
TIME_ZONE=Asia/Dhaka

# --- Database (shared PostgreSQL) -----------------------------------------
# Get these three lines from:  bash scripts/create-db.sh tracking
POSTGRES_DB=tracking
POSTGRES_USER=tracking
POSTGRES_PASSWORD=change-me

# --- Sign in with the Marketian account ------------------------------------
# Get these two lines from:
#   docker compose exec accounts python manage.py register_product tracking https://tracking.marketian.net
ACCOUNTS_URL=https://accounts.marketian.net
MARKETIAN_CLIENT_ID=
MARKETIAN_CLIENT_SECRET=
# Marketian accounts that may use the admin pages (/admin/), comma separated.
ADMIN_EMAILS=

# --- Tracking --------------------------------------------------------------
# Encrypts destination secrets. Same value in ../engine/.env. Generate with:
#   python -c "from common.crypto import generate_key; print(generate_key('k1'))"
# To rotate: put a new key first (k2:...,k1:...), save every destination again, then drop k1.
TRACKING_ENC_KEYS=
REDIS_URL=redis://tracking-redis:6379/0
# Client hosts are pointed here (CNAME), or at this IP (A record).
EDGE_CNAME_TARGET=edge.marketian.net
EDGE_PUBLIC_IP=
# dns on the server; trust only on a PC, where fake hosts like data.shop.test can't pass a DNS check.
DOMAIN_VERIFY_MODE=dns
EVENT_RETENTION_DAYS=14
META_GRAPH_VERSION=v26.0
