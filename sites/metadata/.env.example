# Copy this file to `.env` and fill in the values.

# --- Product ------------------------------------------------------------
PRODUCT_NAME=Metadata
PRODUCT_TAGLINE=A Marketian product.

# --- Core ---------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=metadata.marketian.net
CSRF_TRUSTED_ORIGINS=https://metadata.marketian.net
TIME_ZONE=Asia/Dhaka

# --- Database (shared PostgreSQL) -----------------------------------------
# Get these three lines from:  bash scripts/create-db.sh metadata
POSTGRES_DB=metadata
POSTGRES_USER=metadata
POSTGRES_PASSWORD=change-me

# --- Sign in with the Marketian account ------------------------------------
# Get these two lines from:
#   docker compose exec accounts python manage.py register_product metadata https://metadata.marketian.net
ACCOUNTS_URL=https://accounts.marketian.net
MARKETIAN_CLIENT_ID=
MARKETIAN_CLIENT_SECRET=
