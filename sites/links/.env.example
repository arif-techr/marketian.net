# Copy this file to `.env` and fill in the values.

# --- Product ------------------------------------------------------------
PRODUCT_NAME=Links
PRODUCT_TAGLINE=Short links with click analytics and QR codes.

# --- Core ---------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=links.marketian.net
CSRF_TRUSTED_ORIGINS=https://links.marketian.net
TIME_ZONE=Asia/Dhaka

# --- Database (shared PostgreSQL) -----------------------------------------
# Get these three lines from:  bash scripts/create-db.sh links
POSTGRES_DB=links
POSTGRES_USER=links
POSTGRES_PASSWORD=change-me

# --- Short links ----------------------------------------------------------
# Most new links one person can make per day.
LINKS_PER_DAY=100

# --- Sign in with the Marketian account ------------------------------------
# Get these two lines from:
#   docker compose exec accounts python manage.py register_product links https://links.marketian.net
ACCOUNTS_URL=https://accounts.marketian.net
MARKETIAN_CLIENT_ID=
MARKETIAN_CLIENT_SECRET=
