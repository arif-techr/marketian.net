# Copy this file to `.env` and fill in the values.

# --- Core ---------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=marketian.net,www.marketian.net,marketain.net,www.marketain.net
CSRF_TRUSTED_ORIGINS=https://marketian.net,https://www.marketian.net,https://marketain.net,https://www.marketain.net
# All other domains (marketain.net, www.*) redirect here. Leave empty to disable.
CANONICAL_HOST=marketian.net
TIME_ZONE=Asia/Dhaka

# --- Database ---------------------------------------------------------------
# In Docker the site always uses its own PostgreSQL container (marketian-db);
# only the password is required. Without Docker, no POSTGRES_DB means SQLite.
POSTGRES_DB=marketian
POSTGRES_USER=marketian
POSTGRES_PASSWORD=change-me-too
# Gunicorn worker processes (Docker).
# GUNICORN_WORKERS=3

# Set True if your host has no web server serving /media/ (uploaded photo, CV).
SERVE_MEDIA=False
# Set False if your host already forces HTTPS and you get a redirect loop.
SECURE_SSL_REDIRECT=True
# After HTTPS works everywhere, you may set this to 31536000.
SECURE_HSTS_SECONDS=0

# --- Email (contact form, replies, templates) ----------------------------
# Public address of the site, used for links and your photo inside emails.
SITE_URL=https://marketian.net

# Where contact form messages are delivered (comma separated).
CONTACT_RECIPIENTS=hello@marketian.net

# SMTP account that sends the notification.
# cPanel mailbox example:  mail.marketian.net / 465 / SSL
# Gmail example:            smtp.gmail.com / 587 / TLS + an App Password
EMAIL_HOST=mail.marketian.net
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=no-reply@marketian.net
EMAIL_HOST_PASSWORD=your-mailbox-password
DEFAULT_FROM_EMAIL=Marketian <no-reply@marketian.net>
