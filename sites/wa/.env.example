# Copy to .env and fill in the values (on the server: sites/wa/.env).
# For local development run `npm run setup` instead: it fills in random secrets and local addresses.
# One file configures every part: Django, Celery, the WhatsApp gateway and Docker Compose.
# Generate each secret with:  openssl rand -hex 24

# ---------- Django ----------
# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# false for Docker and any VPS. true only for `npm run dev` on your own computer.
DJANGO_DEBUG=false
# Hostnames the site is served on.
DJANGO_ALLOWED_HOSTS=wa.marketian.net
# Full origins the browser uses (scheme + host + port).
DJANGO_CSRF_TRUSTED_ORIGINS=https://wa.marketian.net
# true behind HTTPS (the server); false for local development.
DJANGO_SECURE=true
# Base of public file links (attachments sent by link).
PUBLIC_BASE_URL=https://wa.marketian.net
# Time zone for "today" (daily limits, charts) and scheduling. e.g. Asia/Dhaka, Europe/London
TIME_ZONE=Asia/Dhaka
# Largest attachment, in MB.
MAX_UPLOAD_MB=25

# ---------- Sign in with the Marketian account ----------
# Owners sign in at accounts.marketian.net (GitHub or email). Get the two lines with:
#   docker compose exec accounts python manage.py register_product wa https://wa.marketian.net
# Leave the client ID empty to use only the username + password sign-in (local development).
ACCOUNTS_URL=https://accounts.marketian.net
MARKETIAN_CLIENT_ID=
MARKETIAN_CLIENT_SECRET=

# Who may start a workspace. false: only people you add (in /admin/, a user with their email:
# they then sign in with their Marketian account). true: anyone with a Marketian account
# (or, without it, anyone using "Create an account" on the sign-in page).
# Keep false unless strangers may send WhatsApp messages from this server.
ALLOW_SIGNUP=false

# First dashboard user (username + password, for /admin/), created automatically if no users exist yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password

# ---------- Database & queue ----------
# Docker Compose builds DATABASE_URL and REDIS_URL itself; you only set the Postgres password.
POSTGRES_PASSWORD=change-me
# Without Docker: leave both empty to use SQLite and the built-in worker (no Redis needed).
# DATABASE_URL=postgres://wab:password@127.0.0.1:5432/wab
# REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=
REDIS_URL=

# ---------- WhatsApp connection ----------
# builtin   = the bundled Node/Baileys gateway (./gateway)
# evolution = Evolution API (start it with: docker compose --profile evolution up -d)
WA_PROVIDER=builtin

# Built-in gateway. The API key is shared between Django and the gateway.
GATEWAY_API_KEY=change-me
GATEWAY_URL=http://127.0.0.1:3100
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3100
GATEWAY_WEBHOOK_URL=http://127.0.0.1:8000/api/whatsapp/webhook/
# WhatsApp library log level: silent, error, warn, info, debug
WA_LOG_LEVEL=warn

# Evolution API (only when WA_PROVIDER=evolution)
EVOLUTION_API_KEY=change-me
EVOLUTION_URL=http://127.0.0.1:8080
# Where the WhatsApp provider sends events back to Django.
WEBHOOK_URL=http://127.0.0.1:8000/api/whatsapp/webhook/

# ---------- Local development ----------
# Reverse proxies in front of Django (for real client IPs). On the server Docker Compose sets 2
# (Caddy + the UI's Nginx) itself.
NUM_PROXIES=0
