# Copy this file to `.env` and fill in the values. Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Core -------------------------------------------------------------------
SECRET_KEY=change-me
DEBUG=False
APP_URL=https://sms.marketian.net
ALLOWED_HOSTS=sms.marketian.net,sms-api
TIME_ZONE=Asia/Dhaka

# --- Shared with the panel (../web/.env): must be identical there ------------------
API_KEY_PEPPER=change-me
SETTINGS_ENCRYPTION_KEY=change-me
FRONTEND_PROXY_SECRET=change-me
# Bearer token for /api/v1/internal/ready (monitoring). Optional.
CRON_SECRET=

# --- Database (shared PostgreSQL) -----------------------------------------------
# Get these three lines from:  bash scripts/create-db.sh sms
POSTGRES_DB=sms
POSTGRES_USER=sms
POSTGRES_PASSWORD=change-me

# --- Queue ----------------------------------------------------------------------
REDIS_URL=redis://sms-redis:6379/0

# --- Sign in with the Marketian account ------------------------------------------
# Get these two lines from:
#   docker compose exec accounts python manage.py register_product sms https://sms.marketian.net
ACCOUNTS_URL=https://accounts.marketian.net
MARKETIAN_CLIENT_ID=
MARKETIAN_CLIENT_SECRET=
